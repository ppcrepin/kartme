{
  "expo": {
    "name": "KartSquad",
    "slug": "kartsquad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kartsquad",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0706",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0706",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KartSquad s’en sert uniquement pour trier les circuits du plus proche au plus loin. La position n’est ni enregistrée, ni partagée."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0a0706",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ppcrepin.kartsquad",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KartSquad s’en sert uniquement pour trier les circuits du plus proche au plus loin. La position n’est ni enregistrée, ni partagée.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    }
  }
}
